{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "DbDataBuild project configuration",
  "description": "dbdatabuild.yml at the project root. Offline settings only: credentials are never stored here, they come from the runtime environment. Every key is optional; an absent key takes the built-in default, which every command prints in its header. This schema is for editors; `dbdatabuild validate` applies the same rules with diagnostic codes.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "default_targets": {
      "description": "Targets a model is validated for when it declares no `targets:`. Default: [sqlserver].",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "targets": {
      "description": "Per-target settings used by offline checks.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sqlserver": {
          "$ref": "#/$defs/targetSettings"
        },
        "fabric": {
          "$ref": "#/$defs/targetSettings"
        },
        "postgres": {
          "$ref": "#/$defs/targetSettings"
        }
      }
    },
    "tracking_schema": {
      "description": "Schema for the tracking tables. Default: dbdatabuild.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "string_semantics": {
      "description": "The project's string comparison profile (DESIGN.md 7.4). Default: case-insensitive, accent-sensitive, trailing spaces ignored (SQL Server style).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case": {
          "enum": [
            "sensitive",
            "insensitive"
          ]
        },
        "accent": {
          "enum": [
            "sensitive",
            "insensitive"
          ]
        },
        "trailing_space": {
          "enum": [
            "significant",
            "ignored"
          ]
        },
        "collations": {
          "description": "Logical collation name to per-engine collation name.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "duckdb": {
                "$ref": "#/$defs/collation"
              },
              "sqlserver": {
                "$ref": "#/$defs/collation"
              },
              "fabric": {
                "$ref": "#/$defs/collation"
              },
              "postgres": {
                "$ref": "#/$defs/collation"
              }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": {
          "description": "Severity of matrix findings. `unsupported` findings are always errors and cannot be configured.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approximated": {
              "$ref": "#/$defs/severity"
            },
            "emulated": {
              "$ref": "#/$defs/severity"
            },
            "unverified": {
              "$ref": "#/$defs/severity"
            },
            "not_covered": {
              "$ref": "#/$defs/severity"
            }
          }
        }
      }
    },
    "hook_groups": {
      "description": "Named, ordered sets of hooks that models reference with `use: <group>`. Groups do not nest. Hook names inside a group are prefixed with the group name in plans (`group.name`).",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_\\-]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/hook"
        }
      }
    },
    "metadata": {
      "description": "Metadata stored in the target for introspection (`publish-metadata`). `store_on_apply: true` also stores the project and the applied models' documents, and the plan, after every successful `apply`. Default false.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store_on_apply": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "true",
                "false"
              ]
            }
          ]
        }
      }
    },
    "lowering": {
      "description": "Model queries are bound by DuckDB and lowered to one explicit query before they are checked and transpiled (committed under rendered/lowered/). `enabled: false` turns that stage off and transpiles the author's SQL directly, as before; there is no per-model fallback. Default true.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "true",
                "false"
              ]
            }
          ]
        }
      }
    },
    "lint": {
      "description": "Advisory lints. `indexes: false` turns off the index advice (DDB-223, DDB-224) and `slices: false` the slice advice (DDB-225) for the whole project; a model can silence single codes with `lint_ignore`. Both default to true.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "indexes": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "true",
                "false"
              ]
            }
          ]
        },
        "slices": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "true",
                "false"
              ]
            }
          ]
        }
      }
    },
    "rewrites": {
      "description": "Which rewrites make the engines give DuckDB's answers (`dbdatabuild matrix --rewrites` lists them). The default is `fidelity: exact`: all of them. `fidelity: native` turns off every rewrite the targets can do without, for shorter queries and simpler plans, at the price of each engine's own behavior (a trailing space not counted, an integer cut instead of rounded, a week counted another way); `disable` and `enable` change single rewrites. A rewrite a target cannot do without (SQL Server has no LPAD, PostgreSQL's round takes no double) cannot be turned off (DDB-229). A model's section is applied on top of the project's.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fidelity": {
          "enum": [
            "exact",
            "native"
          ]
        },
        "disable": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "length-trailing-spaces",
              "round-double",
              "try-cast-parse",
              "double-to-int",
              "decimal-to-int",
              "double-to-decimal",
              "avg-double",
              "sum-widen",
              "date-to-timestamp",
              "weekday-datefirst",
              "date-diff-boundaries",
              "date-diff-weeks",
              "date-plus-days",
              "concat-plus",
              "pad-to-length",
              "split-part",
              "string-agg-array"
            ]
          }
        },
        "enable": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "length-trailing-spaces",
              "round-double",
              "try-cast-parse",
              "double-to-int",
              "decimal-to-int",
              "double-to-decimal",
              "avg-double",
              "sum-widen",
              "date-to-timestamp",
              "weekday-datefirst",
              "date-diff-boundaries",
              "date-diff-weeks",
              "date-plus-days",
              "concat-plus",
              "pad-to-length",
              "split-part",
              "string-agg-array"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "target": {
      "enum": [
        "sqlserver",
        "fabric",
        "postgres"
      ]
    },
    "severity": {
      "enum": [
        "error",
        "warning",
        "note"
      ]
    },
    "collation": {
      "type": "string",
      "minLength": 1
    },
    "targetSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "description": "The engine's major version (SQL Server 2022 is 16, 2025 is 17). Lets the matrix linter resolve min_version rows.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          ]
        }
      }
    },
    "hook": {
      "title": "hook",
      "description": "A native-SQL script attached to a plan event. `script` is one path, or a path per target; the file is executed exactly as committed. The list order is the run order.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "event",
        "script"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_\\-]*$"
        },
        "event": {
          "description": "pre_ or post_ create, alter, load or backfill. pre_drop and post_drop are reserved: the planner has no drop step yet, so they are refused.",
          "enum": [
            "pre_create",
            "post_create",
            "pre_alter",
            "post_alter",
            "pre_load",
            "post_load",
            "pre_backfill",
            "post_backfill"
          ]
        },
        "script": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(^|/)\\.\\.?(/|$))[^/].*\\.[sS][qQ][lL]$"
            },
            {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "sqlserver",
                  "fabric",
                  "postgres"
                ]
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(^|/)\\.\\.?(/|$))[^/].*\\.[sS][qQ][lL]$"
              }
            }
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sqlserver",
              "fabric",
              "postgres"
            ]
          }
        },
        "effect": {
          "description": "What the script may do: ddl (default) or data. `run` runs only data hooks.",
          "enum": [
            "ddl",
            "data"
          ]
        },
        "risk": {
          "description": "The author's declaration, which sets the plan step's risk class. Default safe.",
          "enum": [
            "safe",
            "risky",
            "destructive"
          ]
        }
      }
    }
  }
}
