<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DbDataBuild.Core\DbDataBuild.Core.csproj" />
    <ProjectReference Include="..\DbDataBuild.Models\DbDataBuild.Models.csproj" />
    <ProjectReference Include="..\DbDataBuild.Targets.DuckDb\DbDataBuild.Targets.DuckDb.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ast\expression-types.txt" LogicalName="expression-types.txt" />
    <EmbeddedResource Include="..\..\matrix\*.yml" LogicalName="matrix/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Native polyglot library: produced by scripts/build-polyglot.sh into native/<rid>/, copied beside the output. -->
  <ItemGroup>
    <None Include="..\..\native\**\*" Link="runtimes\%(RecursiveDir)native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\native')" />
  </ItemGroup>
</Project>
